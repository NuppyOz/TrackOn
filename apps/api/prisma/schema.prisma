  cliente Cliente @relation(fields:[clienteId],references:[id],onDelete:Restrict)
  equipo Equipo? @relation(fields:[equipoId],references:[id],onDelete:Restrict)
  orden OrdenTrabajo? @relation(fields:[ordenId],references:[id],onDelete:Restrict)
  garantia GarantiaGerencial? @relation(fields:[garantiaId],references:[id],onDelete:Restrict)
  anterior CasoCalidadGerencial? @relation("ReincidenciaCalidad",fields:[anteriorId],references:[id],onDelete:Restrict)
  siguientes CasoCalidadGerencial[] @relation("ReincidenciaCalidad")
  autor Usuario @relation(fields:[autorId],references:[id],onDelete:Restrict)
  retrabajos RetrabajoGerencial[]
  correctivas CorrectivaGerencial[]
  @@index([activoReferencia,codigoFalla,abiertaEn])
  @@map("casos_calidad_gerenciales")
}

model RetrabajoGerencial {
  id Int @id @default(autoincrement())
  casoId Int
  referenciaTrabajo String @unique @db.VarChar(100)
  fechaEfectiva DateTime @db.Timestamptz(6)
  motivo String @db.VarChar(2000)
  ordenId Int?
  autorId Int
  registradoEn DateTime @default(now()) @db.Timestamptz(6)
  caso CasoCalidadGerencial @relation(fields:[casoId],references:[id],onDelete:Restrict)
  orden OrdenTrabajo? @relation(fields:[ordenId],references:[id],onDelete:Restrict)
  autor Usuario @relation(fields:[autorId],references:[id],onDelete:Restrict)
  @@map("retrabajos_gerenciales")
}

model CorrectivaGerencial {
  id Int @id @default(autoincrement())
  casoId Int
  descripcion String @db.VarChar(2000)
  responsableId Int
  creadaEn DateTime @db.Timestamptz(6)
  venceEn DateTime @db.Timestamptz(6)
  cerradaEn DateTime? @db.Timestamptz(6)
  resultado String? @db.VarChar(2000)
  autorId Int
  version Int @default(1)
  caso CasoCalidadGerencial @relation(fields:[casoId],references:[id],onDelete:Restrict)
  responsable Empleado @relation(fields:[responsableId],references:[id],onDelete:Restrict)
  autor Usuario @relation(fields:[autorId],references:[id],onDelete:Restrict)
  @@index([venceEn,cerradaEn])
  @@map("correctivas_gerenciales")
}
