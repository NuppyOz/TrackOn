{
    "name": "trackon",
    "version": "0.1.0",
    "private": true,
    "description": "Sistema interno de órdenes de trabajo para taller de equipos fríos",
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "build": "pnpm --filter @trackon/api build && pnpm --dir apps/web build",
        "typecheck": "pnpm --dir apps/api typecheck && pnpm --dir apps/web exec tsc -b",
        "lint": "pnpm --dir apps/web lint",
        "test:web": "pnpm --dir apps/web test",
        "test:api": "pnpm --dir apps/api test",
        "seed:demo": "pnpm --dir apps/api exec tsx prisma/seed-demo.ts",
        "sonar": "node scripts/sonar.mjs"
    },
    "engines": {
        "node": ">=24.22.1 <25"
    }
}
